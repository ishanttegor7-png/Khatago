rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions for validation
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // User isolation: Every user has their own private subtree under /users/{userId}
    match /users/{userId} {
      // Allow user to read and write their own root profile record
      allow read, write: if isOwner(userId);

      // Business Profile subcollection: private to owner
      match /profile/{profileId} {
        allow read, write: if isOwner(userId);
      }

      // Customers subcollection: strictly isolated to the authenticated business owner
      match /customers/{customerId} {
        allow read, write: if isOwner(userId);
      }

      // Financial Transactions subcollection: strictly isolated to the authenticated business owner
      match /transactions/{transactionId} {
        allow read, write: if isOwner(userId);
      }

      // Invoices subcollection: strictly isolated to the authenticated business owner
      match /invoices/{invoiceId} {
        allow read, write: if isOwner(userId);
      }

      // Products subcollection: strictly isolated to the authenticated business owner
      match /products/{productId} {
        allow read, write: if isOwner(userId);
      }

      // Stock movements subcollection: strictly isolated to the authenticated business owner
      match /stock_movements/{movementId} {
        allow read, write: if isOwner(userId);
      }

      // Subscription / Entitlements subcollection: strictly isolated to the authenticated business owner
      match /subscription/{subscriptionId} {
        allow read, write: if isOwner(userId);
      }
    }

    // Explicit default deny for any other collections or paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
